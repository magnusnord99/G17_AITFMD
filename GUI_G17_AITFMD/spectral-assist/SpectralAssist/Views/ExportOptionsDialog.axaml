<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SpectralAssist.ViewModels"
        x:Class="SpectralAssist.Views.ExportOptionsDialog"
        x:DataType="vm:ExportOptionsViewModel"
        Title="PDF-eksportalternativer"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Border Padding="20">
        <StackPanel Spacing="16">

            <!-- Colormap -->
            <StackPanel Spacing="6">
                <TextBlock Text="Farge på overlagsmask (Colormap)"
                           Foreground="#888888" FontSize="11" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding AvailableColorMaps}"
                          SelectedItem="{Binding SelectedColorMapName}"
                          HorizontalAlignment="Stretch"
                          FontSize="12" />
            </StackPanel>

            <!-- Opacity -->
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Gjennomsiktighet på overlag (Opacity)"
                               Foreground="#888888" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Opacity, StringFormat='{}{0:P0}'}"
                               Foreground="#CCCCCC" FontSize="11" Width="36" TextAlignment="Right" />
                </Grid>
                <Slider Value="{Binding Opacity}"
                        Minimum="0" Maximum="1" />
            </StackPanel>

            <!-- Threshold 1 -->
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Terskelverdi — overlag 1"
                               Foreground="#888888" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Overlay1Threshold, StringFormat='{}{0:P0}'}"
                               Foreground="#CCCCCC" FontSize="11" Width="36" TextAlignment="Right" />
                </Grid>
                <Slider Value="{Binding Overlay1Threshold}"
                        Minimum="0" Maximum="1" />
            </StackPanel>

            <!-- Threshold 2 -->
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Terskelverdi — overlag 2"
                               Foreground="#888888" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Overlay2Threshold, StringFormat='{}{0:P0}'}"
                               Foreground="#CCCCCC" FontSize="11" Width="36" TextAlignment="Right" />
                </Grid>
                <Slider Value="{Binding Overlay2Threshold}"
                        Minimum="0" Maximum="1" />
            </StackPanel>

            <TextBlock Text="Grunnlinjebilde (0 %) er alltid inkludert."
                       Foreground="#555555" FontSize="10" FontStyle="Italic" />

            <Border Height="1" Background="#2D2D2D" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton"
                        Content="Avbryt"
                        Background="#2D2D2D"
                        Foreground="#AAAAAA"
                        Padding="12,6"
                        CornerRadius="4" />
                <Button x:Name="ConfirmButton"
                        Content="Eksporter"
                        Background="#2D5A8F"
                        Foreground="#FFFFFF"
                        Padding="12,6"
                        CornerRadius="4" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
