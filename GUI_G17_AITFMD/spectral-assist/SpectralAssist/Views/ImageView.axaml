<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpectralAssist.ViewModels"
             xmlns:paz="using:Avalonia.Controls.PanAndZoom"
             xmlns:scottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:models="clr-namespace:SpectralAssist.Models"
             xmlns:extensions="clr-namespace:SpectralAssist.Extensions"
             mc:Ignorable="d" d:DesignWidth="1860" d:DesignHeight="1000"
             x:Class="SpectralAssist.Views.ImageView"
             x:DataType="vm:ImageViewModel">

    <Design.DataContext>
        <vm:ImageViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Loading State -->
        <StackPanel IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <TextBlock Text="{Binding StatusMessage}"
                       HorizontalAlignment="Center"
                       Foreground="#AAAAAA" />
            <ProgressBar Value="{Binding Progress}"
                         Minimum="0" Maximum="1"
                         Width="300" Height="4" />
        </StackPanel>

        <!-- Error State -->
        <StackPanel IsVisible="{Binding IsError}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <TextBlock Text="⚠" FontSize="48"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#FF6B6B"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Ready State -->
        <Grid IsVisible="{Binding IsReady}"
              ColumnDefinitions="260,*">

            <!-- LEFT: Sidebar -->
            
            
            <Border Grid.Column="0"
        Background="#161616"
        BorderBrush="#2D2D2D"
        BorderThickness="0,0,1,0">
    <DockPanel LastChildFill="True">

        <!-- TOP: Active run details (only shown when ActiveRun != null) -->
        <Border DockPanel.Dock="Top"
                Padding="14,12"
                BorderBrush="#2D2D2D"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding Overlay.ClassificationResult,
                            Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8" DataContext="{Binding Overlay.ClassificationResult}">

                <!-- Header -->
                <StackPanel Spacing="2">
                    <TextBlock Text="ACTIVE RUN"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#666"
                               LetterSpacing="1" />
                    <TextBlock Text="{Binding ModelMetadata.Name}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#E0E0E0" />
                    <TextBlock FontSize="10" Foreground="#888">
                        <Run Text="v" /><Run Text="{Binding ModelMetadata.Version}" />
                        <Run Text=" · " />
                        <Run Text="{Binding CompletedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                        <Run Text=" · " />
                        <Run Text="{Binding ExecutionProvider}" />
                    </TextBlock>
                </StackPanel>

                <!-- Accuracy badge -->
                <TextBlock FontSize="11" Foreground="#CCCCCC"
                           IsVisible="{Binding ModelTraining.Metrics.Accuracy,
                                       Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Run Text="Validation accuracy: " Foreground="#888" />
                    <Run Text="{Binding ModelTraining.Metrics.Accuracy, StringFormat='{}{0:P1}'}" />
                </TextBlock>

                <Border Height="1" Background="#2D2D2D" Margin="0,2" />

                <!-- Patch geometry -->
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">

                    <TextBlock Text="Patches:" Foreground="#888" FontSize="11"
                               Margin="0,0,12,3" />
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="#CCCCCC"
                               Margin="0,0,0,3">
                        <Run Text="{Binding EvaluatedPatches}" />
                        <Run Text=" / " />
                        <Run Text="{Binding TotalPatches}" />
                    </TextBlock>

                    <TextBlock Grid.Row="1" Text="Patch:" Foreground="#888" FontSize="11"
                               Margin="0,0,12,3" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="#CCCCCC"
                               Margin="0,0,0,3">
                        <Run Text="{Binding PatchW}" />×<Run Text="{Binding PatchH}" /> px
                    </TextBlock>

                    <TextBlock Grid.Row="2" Text="Stride:" Foreground="#888" FontSize="11"
                               Margin="0,0,12,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" Foreground="#CCCCCC">
                        <Run Text="{Binding StrideW}" />×<Run Text="{Binding StrideH}" /> px
                    </TextBlock>
                </Grid>

                <Border Height="1" Background="#2D2D2D" Margin="0,2" />

                <!-- Per-class stats -->
                <ItemsControl ItemsSource="{Binding Statistics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ClassStatistics">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                <TextBlock Text="{Binding ClassName}"
                                           Foreground="#CCCCCC" FontSize="11" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PercentWinner, StringFormat='{}{0}%'}"
                                           Foreground="#888" FontSize="11" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- BOTTOM: Action buttons -->
        <Border DockPanel.Dock="Bottom"
                Padding="12,10"
                BorderBrush="#2D2D2D"
                BorderThickness="0,1,0,0">
            <StackPanel Spacing="6">
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding RunInferenceCommand.IsRunning}" />
                <Button Command="{Binding RunInferenceCancelCommand}"
                        IsVisible="{Binding RunInferenceCommand.IsRunning}"
                        Content="Cancel" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

                <Button Content="▶ Run Inference"
                        Command="{Binding RunInferenceCommand}"
                        IsEnabled="{Binding !RunInferenceCommand.IsRunning}"
                        IsVisible="{Binding !RunInferenceCommand.IsRunning}"
                        Background="RoyalBlue"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="8,8" CornerRadius="4" FontWeight="SemiBold" />

                <Button Content="⇩ Export PDF"
                        Command="{Binding ExportPdfCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="8,6" CornerRadius="4" />
            </StackPanel>
        </Border>

        <!-- MIDDLE: Runs list -->
        <Border DockPanel.Dock="Top" Padding="14,12,14,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Runs" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ImageNode.Runs.Count}"
                           Foreground="#666" FontSize="11" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="No runs yet. Click Run Inference."
                           FontSize="11" Foreground="#666" TextWrapping="Wrap"
                           Margin="14,4,14,0"
                           IsVisible="{Binding !ImageNode.Runs.Count}" />

                <ItemsControl ItemsSource="{Binding ImageNode.Runs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:RunSummary">
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="14,8"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[ItemsControl].((vm:ImageViewModel)DataContext).LoadRunCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">

                                    <!-- Active indicator dot -->
                                    <Ellipse Width="6" Height="6"
                                             Fill="RoyalBlue"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>
                                             <!-- IsActive needs converter — see below -->

                                    <!-- Model name + percentage -->
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               Foreground="#E0E0E0"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ModelDisplayName}" />
                                        <Run Text=" · " Foreground="#666" />
                                        <Run Text="{Binding PositiveClassPercentAbove50, StringFormat='{}{0:0}%'}" />
                                    </TextBlock>

                                    <!-- Delete -->
                                    <Button Grid.Column="2"
                                            Content="🗑"
                                            Background="Transparent"
                                            Foreground="#666"
                                            Padding="4,0" FontSize="11"
                                            Command="{Binding $parent[ItemsControl].((vm:ImageViewModel)DataContext).DeleteRunCommand}"
                                            CommandParameter="{Binding}" />

                                    <!-- Date -->
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding CompletedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                               FontSize="10" Foreground="#888" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Border>
            
            
            
            
            
            <!-- RIGHT: ImageContainer and Bottom Display Settings -->
            <Grid Grid.Column="1" RowDefinitions="*, 56">

                <!-- Single vs SplitView Grid  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition
                            Width="{Binding IsSplitViewEnabled,
                             Converter={x:Static extensions:BoolToGridLengthConverter.Instance},
                             ConverterParameter=2}" />
                        <ColumnDefinition
                            Width="{Binding IsSplitViewEnabled,
                             Converter={x:Static extensions:BoolToGridLengthConverter.Instance},
                             ConverterParameter=*}" />
                    </Grid.ColumnDefinitions>

                    <!-- Single Image or Left Side Split Image -->
                    <paz:ZoomBorder Grid.Column="0" x:Name="ZoomBorderLeft"
                                    Background="#121212" Stretch="None"
                                    BoundsMode="KeepContentVisible" ClipToBounds="True"
                                    EnableConstrains="True" EnablePan="True" PanButton="Left"
                                    ZoomSpeed="1.05" MinZoomX="0.5" MinZoomY="0.5"
                                    MaxZoomX="40" MaxZoomY="40">
                        <Canvas Width="{Binding ImageWidth}"
                                Height="{Binding ImageHeight}">

                            <Image Source="{Binding CurrentBitmap}"
                                   PointerPressed="OnImagePointerPressed" />

                            <Image Source="{Binding Overlay.OverlayBitmap}"
                                   Opacity="{Binding Overlay.OverlayOpacity}"
                                   IsHitTestVisible="False">
                                <Image.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="Overlay.ShowOverlay" />
                                        <Binding Path="!IsSplitViewEnabled" />
                                    </MultiBinding>
                                </Image.IsVisible>
                            </Image>

                            <!-- Pixel 1: Yellow (Shift) -->
                            <Ellipse Width="14" Height="14"
                                     Stroke="Yellow"
                                     StrokeThickness="2"
                                     Fill="Transparent"
                                     IsHitTestVisible="False"
                                     IsVisible="{Binding Pixel1X, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     Canvas.Left="{Binding Pixel1X}"
                                     Canvas.Top="{Binding Pixel1Y}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="-7" Y="-7" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Pixel 2: Red (Ctrl) -->
                            <Ellipse Width="14" Height="14"
                                     Stroke="Red"
                                     StrokeThickness="2"
                                     Fill="Transparent"
                                     IsHitTestVisible="False"
                                     IsVisible="{Binding Pixel2X, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     Canvas.Left="{Binding Pixel2X}"
                                     Canvas.Top="{Binding Pixel2Y}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="-7" Y="-7" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                        </Canvas>
                    </paz:ZoomBorder>

                    <!-- Spacer Border -->
                    <Border Grid.Column="1" IsVisible="{Binding IsSplitViewEnabled}"
                            BorderBrush="#2D2D2D" BorderThickness="1,0,1,0" />

                    <!-- Right Side Split Image -->
                    <paz:ZoomBorder Grid.Column="2" x:Name="ZoomBorderRight"
                                    Background="#121212" Stretch="None"
                                    BoundsMode="KeepContentVisible" ClipToBounds="True"
                                    EnableConstrains="True" EnablePan="True" PanButton="Left"
                                    ZoomSpeed="1.05" MinZoomX="0.5" MinZoomY="0.5"
                                    MaxZoomX="40" MaxZoomY="40">

                        <Canvas Width="{Binding ImageWidth}"
                                Height="{Binding ImageHeight}">

                            <Image Source="{Binding CurrentBitmap}"
                                   PointerPressed="OnImagePointerPressed" />

                            <Image Source="{Binding Overlay.OverlayBitmap}"
                                   Opacity="{Binding Overlay.OverlayOpacity}"
                                   IsVisible="{Binding Overlay.ShowOverlay}"
                                   IsHitTestVisible="False" />

                            <!-- Pixel 1: Yellow (Shift) -->
                            <Ellipse Width="14" Height="14"
                                     Stroke="Yellow"
                                     StrokeThickness="2"
                                     Fill="Transparent"
                                     IsHitTestVisible="False"
                                     IsVisible="{Binding Pixel1X, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     Canvas.Left="{Binding Pixel1X}"
                                     Canvas.Top="{Binding Pixel1Y}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="-7" Y="-7" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Pixel 2: Red (Ctrl) -->
                            <Ellipse Width="14" Height="14"
                                     Stroke="Red"
                                     StrokeThickness="2"
                                     Fill="Transparent"
                                     IsHitTestVisible="False"
                                     IsVisible="{Binding Pixel2X, Converter={x:Static ObjectConverters.IsNotNull}}"
                                     Canvas.Left="{Binding Pixel2X}"
                                     Canvas.Top="{Binding Pixel2Y}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="-7" Y="-7" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                        </Canvas>
                    </paz:ZoomBorder>
                </Grid>

                <!-- Status Text -->
                <TextBlock Grid.Row="0" Text="{Binding InferenceOutput}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="16,16,0,0">
                </TextBlock>

                <!-- Color Bar Legend -->
                <Border Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        Background="#CC1E1E1E"
                        CornerRadius="4"
                        Padding="8,6"
                        IsVisible="{Binding Overlay.ShowOverlay}">
                    <StackPanel
                        IsVisible="{Binding Overlay.ClassificationResult,
                                        Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Image Source="{Binding Overlay.ColorBarBitmap}"
                               Width="200" Height="14"
                               Stretch="Fill" />
                        <Grid Width="200" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Overlay.OverlayThreshold, StringFormat='{}{0:P0}'}"
                                       HorizontalAlignment="Left"
                                       Foreground="#AAAAAA"
                                       FontSize="10" />
                            <TextBlock Text="100%"
                                       HorizontalAlignment="Right"
                                       Foreground="#AAAAAA"
                                       FontSize="10" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,16,16,0"
                        Background="#DD1A1A1A"
                        BorderBrush="#2D2D2D"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        IsVisible="{Binding HasAnySelection}">

                    <!-- Plot Container -->
                    <Grid>
                        <scottPlot:AvaPlot x:Name="SpectrumPlot"
                                           Width="300"
                                           Height="180"
                                           Margin="0,16,0,0" />

                        <Grid VerticalAlignment="Top"
                              ColumnDefinitions="*,Auto"
                              Margin="8,0,4,0">
                            <TextBlock Grid.Column="0"
                                       Text="Spectral Signature: Reflectance vs λ (nm)"
                                       Foreground="#CCCCCC"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Padding="4,4"
                                    FontSize="12"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnClearSpectrumClicked" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Spectral Slider Panel -->
                <Border Grid.Row="0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Margin="16,0,248,16"
                        Background="#CC1E1E1E"
                        CornerRadius="4"
                        Padding="12,10"
                        IsVisible="{Binding IsSpectralMode}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedBand, StringFormat='Band {0}'}"
                                       Foreground="#CCCCCC" FontSize="11" FontWeight="SemiBold" MinWidth="60" />
                            <TextBlock Foreground="#AAAAAA" FontSize="11" MinWidth="80">
                                <Run Text="λ " />
                                <Run Text="{Binding SelectedBandWaveLength, StringFormat='{}{0:F1}'}" />
                                <Run Text="{Binding WavelengthUnit}" />
                            </TextBlock>
                        </StackPanel>

                        <Slider Grid.Column="1" Margin="16,0"
                                Padding="0,0,0,18"
                                Minimum="0" Maximum="{Binding MaxBandIndex}"
                                Value="{Binding SelectedBand}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Height="22"
                                VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Foreground="#888888" FontSize="11" VerticalAlignment="Center">
                            <Run Text="0 – " />
                            <Run Text="{Binding MaxBandIndex}" />
                        </TextBlock>
                    </Grid>
                </Border>


                <!-- Bottom Toolbar -->
                <Border Grid.Row="1"
                        Background="#1E1E1E"
                        BorderBrush="#2D2D2D"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">

                        <!-- LEFT: View Options -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">

                            <TextBlock Text="View"
                                       Foreground="#666666"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0" />

                            <RadioButton Content="RGB"
                                         GroupName="DisplayMode"
                                         IsChecked="{Binding IsRgbMode}"
                                         FontSize="12" />
                            <RadioButton Content="Spectral"
                                         GroupName="DisplayMode"
                                         IsChecked="{Binding IsSpectralMode}"
                                         FontSize="12" />

                            <ToggleButton IsChecked="{Binding IsSplitViewEnabled}"
                                          Padding="12,6" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="⊟" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Split View" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton IsChecked="{Binding Overlay.ShowOverlay}"
                                          IsEnabled="{Binding Overlay.ClassificationResult,
                                  Converter={x:Static ObjectConverters.IsNotNull}}"
                                          Padding="12,6" FontSize="12">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="👁" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Show Overlay" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                        </StackPanel>

                        <!-- MIDDLE: Empty/Spacer -->
                        <Grid Grid.Column="1"></Grid>

                        <!-- RIGHT: Overlay Options -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">

                            <!-- Colormap -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Colormap"
                                           Foreground="#888888" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Overlay.AvailableColorMaps}"
                                          SelectedItem="{Binding Overlay.SelectedColorMapName}"
                                          MinWidth="140" FontSize="12"
                                          VerticalAlignment="Center"
                                          IsEnabled="{Binding Overlay.ShowOverlay}" />
                            </StackPanel>

                            <!-- Opacity -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Opacity"
                                           Foreground="#888888" FontSize="12" VerticalAlignment="Center" />
                                <Slider Value="{Binding Overlay.OverlayOpacity}"
                                        Minimum="0" Maximum="1" Width="120"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding Overlay.ShowOverlay}" />
                                <TextBlock Text="{Binding Overlay.OverlayOpacity, StringFormat='{}{0:P0}'}"
                                           Foreground="#CCCCCC" FontSize="12"
                                           VerticalAlignment="Center" Width="36" />
                            </StackPanel>

                            <!-- Threshold -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Threshold"
                                           Foreground="#888888" FontSize="12" VerticalAlignment="Center" />
                                <Slider Value="{Binding Overlay.OverlayThreshold}"
                                        Minimum="0" Maximum="1" Width="120"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding Overlay.ShowOverlay}" />
                                <TextBlock Text="{Binding Overlay.OverlayThreshold, StringFormat='{}{0:P0}'}"
                                           Foreground="#CCCCCC" FontSize="12"
                                           VerticalAlignment="Center" Width="36" />
                            </StackPanel>


                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Panel>
</UserControl>