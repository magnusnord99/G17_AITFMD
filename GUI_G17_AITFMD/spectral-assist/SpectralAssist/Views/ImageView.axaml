<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpectralAssist.ViewModels"
             xmlns:paz="using:Avalonia.Controls.PanAndZoom"
             xmlns:scottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:extensions="clr-namespace:SpectralAssist.Extensions"
             xmlns:components="clr-namespace:SpectralAssist.ViewModels.Components"
             xmlns:shared="clr-namespace:SpectralAssist.Views.Components"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1860" d:DesignHeight="1000"
             x:Class="SpectralAssist.Views.ImageView"
             x:DataType="vm:ImageViewModel">

    <Design.DataContext>
        <vm:ImageViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Loading State -->
        <StackPanel IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="6"
                    Width="360">

            <!-- Phase status + progress -->
            <TextBlock Text="{Binding StatusMessage}"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,16,0,0" />

            <ProgressBar Value="{Binding Progress}"
                         Minimum="0" Maximum="1"
                         HorizontalAlignment="Stretch"
                         Height="4" />

            <TextBlock Text="{Binding LoadingMetadata}"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="0,16,0,0" />

            <!-- Cancel -->
            <Button Content="Cancel"
                    Classes="action"
                    Command="{Binding CancelLoadCommand}"
                    HorizontalAlignment="Center"
                    MinWidth="120"
                    Margin="0,12,0,0" />
        </StackPanel>

        <!-- Error State -->
        <StackPanel IsVisible="{Binding IsError}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ui:FontIcon Glyph="&#xE7BA;" FontSize="48"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Ready State -->
        <shared:SidebarLayout IsVisible="{Binding IsReady}">

            <!-- SIDEBAR HEADER -->
            <shared:SidebarLayout.SidebarHeader>
                <StackPanel>

                    <!-- Uncalibrated warning: only shown when missing -->
                    <ui:InfoBar IsOpen="{Binding !IsCalibrated}"
                                IsVisible="{Binding !IsCalibrated}"
                                Severity="Error"
                                IsClosable="False"
                                Message="Image not calibrated! Results may be inaccurate."
                                Margin="0, 0, 0, 6"/>

                    <!-- Runs section label with count -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0" Text="Available Runs" Classes="section-title"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RunCards.Count}"
                                   Classes="section-title"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </shared:SidebarLayout.SidebarHeader>


            <!-- SIDEBAR CONTENT: Runs list -->
            <shared:SidebarLayout.SidebarContent>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="No runs yet. Click Run Inference."
                                   Classes="caption"
                                   TextWrapping="Wrap"
                                   Margin="12,4,12,0"
                                   IsVisible="{Binding HasNoRuns}" />

                        <ItemsControl ItemsSource="{Binding RunCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="components:RunCardViewModel">
                                    <Button Margin="8,4"
                                            Classes="run-card"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[ItemsControl].((vm:ImageViewModel)DataContext).LoadRunCommand}"
                                            CommandParameter="{Binding Run}">
                                        <StackPanel Spacing="6">

                                            <!-- Header row: model name + delete -->
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                           Text="{Binding ModelDisplayName}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Grid.Row="1" Grid.Column="0"
                                                           Text="{Binding CompletedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           VerticalAlignment="Center" />

                                                <Button Grid.Row="0" Grid.Column="1"
                                                        Classes="icon-danger"
                                                        Command="{Binding $parent[ItemsControl].((vm:ImageViewModel)DataContext).DeleteRunCommand}"
                                                        CommandParameter="{Binding Run}">
                                                    <ui:SymbolIcon Symbol="Delete" FontSize="14" />
                                                </Button>
                                            </Grid>

                                            <!-- Positive % big stat -->
                                            <Grid ColumnDefinitions="*,*"
                                                  ColumnSpacing="16"
                                                  VerticalAlignment="Center">

                                                <Grid Grid.Column="0" ColumnDefinitions="Auto,*"
                                                      VerticalAlignment="Center">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding PositiveClassPercentAbove50, StringFormat='{}{0:0}%'}"
                                                               FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="0"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PositiveClassName}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="≥ 50% conf."
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*"
                                                      VerticalAlignment="Center">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding PositiveClassPercentAbove80, StringFormat='{}{0:0}%'}"
                                                               FontSize="20" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="0"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PositiveClassName}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="≥ 80% conf."
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                </Grid>

                                            </Grid>

                                            <!-- ACTIVE-ONLY DETAILS -->
                                            <ContentControl IsVisible="{Binding IsActive}">
                                                <StackPanel Spacing="10"
                                                            DataContext="{Binding $parent[ItemsControl].((vm:ImageViewModel)DataContext).Overlay.ClassificationResult}">

                                                    <Border Classes="divider" Margin="0,4,0,0" />


                                                    <!-- Coverage + Skipped big stats -->
                                                    <Grid ColumnDefinitions="*,*"
                                                          ColumnSpacing="16"
                                                          VerticalAlignment="Center">

                                                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*"
                                                              VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding CoveragePercent, StringFormat='{}{0:0}%'}"
                                                                       FontSize="20" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Spacing="0"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="Evaluated"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <TextBlock FontSize="10"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                                    <Run Text="{Binding EvaluatedPatches}" />
                                                                    <Run Text=" of " />
                                                                    <Run Text="{Binding TotalPatches}" />
                                                                    <Run Text=" patches" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*"
                                                              VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding SkippedPercent, StringFormat='{}{0:0}%'}"
                                                                       FontSize="20" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Spacing="0"
                                                                        Margin="8,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="Skipped"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                <TextBlock Text="background / sparse tissue"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>

                                                    <!-- Patch + Stride mini-stats (kept smaller, technical) -->
                                                    <Grid ColumnDefinitions="*,*">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="PATCH" Classes="mini-label" />
                                                            <TextBlock Classes="mini-value" FontSize="12">
                                                                <Run Text="{Binding PatchW}" />
                                                                <Run Text="×" />
                                                                <Run Text="{Binding PatchH}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="STRIDE" Classes="mini-label" />
                                                            <TextBlock Classes="mini-value" FontSize="12">
                                                                <Run Text="{Binding StrideW}" />
                                                                <Run Text="×" />
                                                                <Run Text="{Binding StrideH}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                    
                                                </StackPanel>
                                            </ContentControl>
                                            
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

            </shared:SidebarLayout.SidebarContent>

            <!-- SIDEBAR ACTIONS -->
            <shared:SidebarLayout.SidebarActions>
                <StackPanel Spacing="8">

                    <!-- Action buttons -->
                    <StackPanel Spacing="6">

                        <!-- Disabled explanation -->
                        <TextBlock Text="{Binding RunBlockedReason}"
                                   Classes="caption"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   IsVisible="{Binding RunBlockedReason,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Last run error -->
                        <TextBlock Text="{Binding LastRunError}"
                                   Classes="caption"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding LastRunError,
                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Inference Run / Progress / Cancel button -->
                        <Grid Height="36">

                            <!-- Idle: Run Inference button -->
                            <Button Classes="sidebar action"
                                    Command="{Binding RunInferenceCommand}"
                                    IsVisible="{Binding !RunInferenceCommand.IsRunning}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Play" FontSize="14" />
                                    <TextBlock Text="Run Inference" />
                                </StackPanel>
                            </Button>

                            <!-- Running: ProgressBar -->
                            <Grid IsVisible="{Binding RunInferenceCommand.IsRunning}">
                                <ProgressBar Value="{Binding InferenceProgress}"
                                             Minimum="0" Maximum="1"
                                             IsIndeterminate="{Binding IsPreprocessingPhase}"
                                             Height="36"
                                             MinHeight="36"
                                             VerticalAlignment="Stretch"
                                             HorizontalAlignment="Stretch"
                                             Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                             BorderThickness="1"
                                             BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                             CornerRadius="{DynamicResource ControlCornerRadius}" />

                                <!-- Clickable cancel overlay -->
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Padding="8,0"
                                        Command="{Binding RunInferenceCancelCommand}"
                                        ToolTip.Tip="Click to cancel">
                                    <TextBlock Text="{Binding RunStatusText}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="12" />
                                </Button>
                            </Grid>
                        </Grid>

                        <Button Classes="sidebar action"
                                Command="{Binding ToggleNotesCommand}"
                                ToolTip.Tip="Notes about this image">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Edit" FontSize="14" />
                                <TextBlock Text="Notes" />
                            </StackPanel>
                        </Button>

                        <Button Classes="sidebar action" Command="{Binding ExportPdfCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Save" FontSize="14" />
                                <TextBlock Text="Export to PDF" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </shared:SidebarLayout.SidebarActions>


            <!-- MAIN CONTENT -->
            <shared:SidebarLayout.MainContent>
                <Grid RowDefinitions="*, 56">

                    <!-- Single vs SplitView Grid -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition
                                Width="{Binding IsSplitViewEnabled,
                                    Converter={x:Static extensions:BoolToGridLengthConverter.Instance},
                                    ConverterParameter=2}" />
                            <ColumnDefinition
                                Width="{Binding IsSplitViewEnabled,
                                    Converter={x:Static extensions:BoolToGridLengthConverter.Instance},
                                    ConverterParameter=*}" />
                        </Grid.ColumnDefinitions>

                        <!-- Single Image or Left Side Split Image -->
                        <paz:ZoomBorder Grid.Column="0" x:Name="ZoomBorderLeft"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Stretch="None"
                                        BoundsMode="KeepContentVisible" ClipToBounds="True"
                                        EnableConstrains="True" EnablePan="True" PanButton="Left"
                                        ZoomSpeed="1.05" MinZoomX="0.5" MinZoomY="0.5"
                                        MaxZoomX="40" MaxZoomY="40">
                            <Canvas Width="{Binding ImageWidth}" Height="{Binding ImageHeight}">
                                <Image Source="{Binding CurrentBitmap}"
                                       PointerPressed="OnImagePointerPressed" />
                                <Image Source="{Binding Overlay.OverlayBitmap}"
                                       Opacity="{Binding Overlay.OverlayOpacity}"
                                       IsHitTestVisible="False">
                                    <Image.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Overlay.ShowOverlay" />
                                            <Binding Path="!IsSplitViewEnabled" />
                                        </MultiBinding>
                                    </Image.IsVisible>
                                </Image>
                                <Ellipse Width="14" Height="14"
                                         Stroke="Yellow" StrokeThickness="2" Fill="Transparent"
                                         IsHitTestVisible="False"
                                         IsVisible="{Binding Pixel1X, Converter={x:Static ObjectConverters.IsNotNull}}"
                                         Canvas.Left="{Binding Pixel1X}" Canvas.Top="{Binding Pixel1Y}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-7" Y="-7" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Width="14" Height="14"
                                         Stroke="Red" StrokeThickness="2" Fill="Transparent"
                                         IsHitTestVisible="False"
                                         IsVisible="{Binding Pixel2X, Converter={x:Static ObjectConverters.IsNotNull}}"
                                         Canvas.Left="{Binding Pixel2X}" Canvas.Top="{Binding Pixel2Y}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-7" Y="-7" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </paz:ZoomBorder>

                        <!-- Spacer Border -->
                        <Border Grid.Column="1" IsVisible="{Binding IsSplitViewEnabled}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,0" />

                        <!-- Right Side Split Image -->
                        <paz:ZoomBorder Grid.Column="2" x:Name="ZoomBorderRight"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Stretch="None"
                                        BoundsMode="KeepContentVisible" ClipToBounds="True"
                                        EnableConstrains="True" EnablePan="True" PanButton="Left"
                                        ZoomSpeed="1.05" MinZoomX="0.5" MinZoomY="0.5"
                                        MaxZoomX="40" MaxZoomY="40">
                            <Canvas Width="{Binding ImageWidth}" Height="{Binding ImageHeight}">
                                <Image Source="{Binding CurrentBitmap}"
                                       PointerPressed="OnImagePointerPressed" />
                                <Image Source="{Binding Overlay.OverlayBitmap}"
                                       Opacity="{Binding Overlay.OverlayOpacity}"
                                       IsVisible="{Binding Overlay.ShowOverlay}"
                                       IsHitTestVisible="False" />
                                <Ellipse Width="14" Height="14"
                                         Stroke="Yellow" StrokeThickness="2" Fill="Transparent"
                                         IsHitTestVisible="False"
                                         IsVisible="{Binding Pixel1X, Converter={x:Static ObjectConverters.IsNotNull}}"
                                         Canvas.Left="{Binding Pixel1X}" Canvas.Top="{Binding Pixel1Y}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-7" Y="-7" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Width="14" Height="14"
                                         Stroke="Red" StrokeThickness="2" Fill="Transparent"
                                         IsHitTestVisible="False"
                                         IsVisible="{Binding Pixel2X, Converter={x:Static ObjectConverters.IsNotNull}}"
                                         Canvas.Left="{Binding Pixel2X}" Canvas.Top="{Binding Pixel2Y}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-7" Y="-7" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </paz:ZoomBorder>
                    </Grid>

                    <!-- Color Bar Legend -->
                    <Border Grid.Row="0"
                            Classes="overlay-panel"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,16,16"
                            IsVisible="{Binding Overlay.ShowOverlay}">
                        <StackPanel
                            IsVisible="{Binding Overlay.ClassificationResult,
                                Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Image Source="{Binding Overlay.ColorBarBitmap}"
                                   Width="200" Height="14" Stretch="Fill" />
                            <Grid Width="200" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Overlay.OverlayThreshold, StringFormat='{}{0:P0}'}"
                                           HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" />
                                <TextBlock Text="100%" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="10" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Spectrum Plot Panel -->
                    <Border Grid.Row="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,16,16,0"
                            Background="{DynamicResource OverlayBackgroundStrong}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="8"
                            IsVisible="{Binding HasAnySelection}">
                        <Grid>
                            <scottPlot:AvaPlot x:Name="SpectrumPlot"
                                               Width="300" Height="180" Margin="0,16,0,0" />
                            <Grid VerticalAlignment="Top" ColumnDefinitions="*,Auto" Margin="8,0,4,0">
                                <TextBlock Grid.Column="0"
                                           Text="Spectral Signature: Reflectance vs λ (nm)"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           IsHitTestVisible="False" />
                                <Button Grid.Column="1"
                                        Classes="icon"
                                        Click="OnClearSpectrumClicked">
                                    <ui:SymbolIcon Symbol="Cancel" FontSize="12" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Notes Panel -->
                    <Border Grid.Row="0"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="16,16,0,0"
                            Width="300"
                            Background="{DynamicResource OverlayBackgroundStrong}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Padding="14,12"
                            IsVisible="{Binding ShowNotes}">
                        <StackPanel Spacing="10">

                            <!-- Title + Close -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="Image Notes"
                                           Classes="section-title"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Classes="icon"
                                        Command="{Binding ToggleNotesCommand}"
                                        ToolTip.Tip="Close notes">
                                    <ui:SymbolIcon Symbol="Cancel" FontSize="12" />
                                </Button>
                            </Grid>

                            <!-- TextBox Area -->
                            <TextBox Text="{Binding ImageNotes}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="200"
                                     FontSize="12"
                                     Watermark="Notes about this sample..."
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />

                            <!-- Save Button -->
                            <Button Content="Save"
                                    Classes="sidebar primary"
                                    Command="{Binding SaveNotesCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Spectral Slider Panel -->
                    <Border Grid.Row="0"
                            Classes="overlay-panel"
                            VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Margin="16,0,248,16"
                            Padding="12,10"
                            IsVisible="{Binding IsSpectralMode}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedBand, StringFormat='Band {0}'}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11"
                                           FontWeight="SemiBold" MinWidth="60" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"
                                           MinWidth="80">
                                    <Run Text="λ " />
                                    <Run Text="{Binding SelectedBandWaveLength, StringFormat='{}{0:F1}'}" />
                                    <Run Text="{Binding WavelengthUnit}" />
                                </TextBlock>
                            </StackPanel>

                            <Slider Grid.Column="1" Margin="16,0" Padding="0,0,0,18"
                                    Minimum="0" Maximum="{Binding MaxBandIndex}"
                                    Value="{Binding SelectedBand}"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Height="22" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       FontSize="11" VerticalAlignment="Center">
                                <Run Text="0 – " />
                                <Run Text="{Binding MaxBandIndex}" />
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Bottom Toolbar -->
                    <Border Grid.Row="1" Classes="bottombar" Padding="16,8">
                        <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="48">

                            <!-- LEFT: View Options -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20"
                                        VerticalAlignment="Center">
                                <TextBlock Text="View"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,4,0" />

                                <RadioButton Content="RGB" GroupName="DisplayMode"
                                             IsChecked="{Binding IsRgbMode}" FontSize="12" />
                                <RadioButton Content="Spectral" GroupName="DisplayMode"
                                             IsChecked="{Binding IsSpectralMode}" FontSize="12" />

                                <ToggleButton IsChecked="{Binding IsSplitViewEnabled}"
                                              Padding="12,6" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="TwoPage" FontSize="14" />
                                        <TextBlock Text="Split View" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>

                                <ToggleButton IsChecked="{Binding Overlay.ShowOverlay}"
                                              IsEnabled="{Binding Overlay.ClassificationResult,
                                                  Converter={x:Static ObjectConverters.IsNotNull}}"
                                              Padding="12,6" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="View" FontSize="14" />
                                        <TextBlock Text="Show Overlay" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>

                            <Grid Grid.Column="1" />

                            <!-- RIGHT: Overlay Options -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Colormap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               FontSize="12" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding Overlay.AvailableColorMaps}"
                                              SelectedItem="{Binding Overlay.SelectedColorMapName}"
                                              MinWidth="140" FontSize="12"
                                              VerticalAlignment="Center"
                                              IsEnabled="{Binding Overlay.ShowOverlay}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Opacity"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               FontSize="12" VerticalAlignment="Center" />
                                    <Slider Value="{Binding Overlay.OverlayOpacity}"
                                            Minimum="0" Maximum="1" Width="120"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding Overlay.ShowOverlay}" />
                                    <TextBlock Text="{Binding Overlay.OverlayOpacity, StringFormat='{}{0:P0}'}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               FontSize="12" VerticalAlignment="Center" Width="36" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Threshold"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               FontSize="12" VerticalAlignment="Center" />
                                    <Slider Value="{Binding Overlay.OverlayThreshold}"
                                            Minimum="0" Maximum="1" Width="120"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding Overlay.ShowOverlay}" />
                                    <TextBlock Text="{Binding Overlay.OverlayThreshold, StringFormat='{}{0:P0}'}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               FontSize="12" VerticalAlignment="Center" Width="36" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </shared:SidebarLayout.MainContent>
        </shared:SidebarLayout>
    </Panel>
</UserControl>