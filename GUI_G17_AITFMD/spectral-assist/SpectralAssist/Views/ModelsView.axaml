<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpectralAssist.ViewModels"
             xmlns:shared="clr-namespace:SpectralAssist.Views.Components"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="SpectralAssist.Views.ModelsView"
             x:DataType="vm:ModelsViewModel">

    <Design.DataContext>
        <vm:ModelsViewModel />
    </Design.DataContext>

    <shared:SidebarLayout>

        <!-- SIDEBAR HEADER -->
        <shared:SidebarLayout.SidebarHeader>
            <StackPanel Spacing="4">
                <TextBlock Text="Model Packages" Classes="section-title" />
                <TextBlock Text="Browse, import, and manage ONNX model packages."
                           Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
        </shared:SidebarLayout.SidebarHeader>

        <!-- SIDEBAR CONTENT: Model list -->
        <shared:SidebarLayout.SidebarContent>
            <ListBox ItemsSource="{Binding AvailableModels}"
                     SelectedItem="{Binding Session.ActiveModel}"
                     IsEnabled="{Binding IsBrowsing}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="6,4">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="1" Margin="2,4">
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Metadata.Id}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </shared:SidebarLayout.SidebarContent>

        <!-- SIDEBAR ACTIONS: Import / Delete / Confirm -->
        <shared:SidebarLayout.SidebarActions>
            <StackPanel Spacing="6">

                <!-- Browsing: Import + Delete -->
                <Button Classes="sidebar action"
                        Click="ImportModelButton_Clicked"
                        IsVisible="{Binding IsBrowsing}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Add" FontSize="14" />
                        <TextBlock Text="Import New" />
                    </StackPanel>
                </Button>

                <Button Classes="sidebar danger"
                        Command="{Binding DeleteModelCommand}"
                        CommandParameter="{Binding Session.ActiveModel}"
                        IsVisible="{Binding IsBrowsing}"
                        IsEnabled="{Binding Session.ActiveModel, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Delete" FontSize="14" />
                        <TextBlock Text="Delete Selected" />
                    </StackPanel>
                </Button>

                <!-- Previewing: Confirm + Cancel -->
                <Button Classes="sidebar action"
                        Command="{Binding ConfirmImportCommand}"
                        IsVisible="{Binding IsPreviewing}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Accept" FontSize="14" />
                        <TextBlock Text="Confirm Import" />
                    </StackPanel>
                </Button>

                <Button Content="Cancel"
                        Classes="sidebar action"
                        Command="{Binding CancelImportCommand}"
                        IsVisible="{Binding IsPreviewing}" />

            </StackPanel>
        </shared:SidebarLayout.SidebarActions>

        <!-- MAIN CONTENT: Details -->
        <shared:SidebarLayout.MainContent>
            <Grid RowDefinitions="Auto,*">

                <!-- Banner Row -->
                <StackPanel Grid.Row="0"
                            Margin="24,20,24,0"
                            Spacing="8"
                            IsVisible="{Binding HasActiveBanner}">

                    <ui:InfoBar IsOpen="{Binding IsPreviewing}"
                                Severity="Warning"
                                IsClosable="False"
                                Message="Review the model details below before importing." />

                    <ui:InfoBar IsOpen="{Binding IsImporting}"
                                Severity="Informational"
                                IsClosable="False"
                                Message="Importing and validating..." />

                    <ui:InfoBar
                        IsOpen="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Severity="Success"
                        IsClosable="True"
                        Message="{Binding SuccessMessage}"
                        CloseButtonCommand="{Binding DismissSuccessCommand}" />

                    <ui:InfoBar IsOpen="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Severity="Error"
                                IsClosable="True"
                                Message="{Binding ErrorMessage}"
                                CloseButtonCommand="{Binding DismissErrorCommand}" />
                </StackPanel>

                <!-- Empty state -->
                <TextBlock Grid.Row="1"
                           Text="Select a model from the list to see its details."
                           FontSize="13" Foreground="{DynamicResource TextFillColorDisabledBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding DisplayedModel, Converter={x:Static ObjectConverters.IsNull}}" />

                <!-- Details ScrollViewer -->
                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding DisplayedModel, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="20"
                                Margin="24,20,24,24"
                                DataContext="{Binding DisplayedModel}">

                        <!-- HERO CARD -->
                        <Border Classes="hero-card">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                                <!-- Title -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Metadata.Name}"
                                           Classes="h1" />

                                <!-- Validation pill -->
                                <Border Grid.Row="0" Grid.Column="1"
                                        Classes="pill success"
                                        IsVisible="{Binding Validation.IsPassed}">
                                    <TextBlock Text="Validation passed" />
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1"
                                        Classes="pill danger"
                                        IsVisible="{Binding Validation.IsFailed}">
                                    <TextBlock Text="Validation failed" />
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1"
                                        Classes="pill warning"
                                        IsVisible="{Binding Validation.IsSkipped}">
                                    <TextBlock Text="Validation skipped" />
                                </Border>

                                <!-- Subtitle (Model ID) -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Metadata.Id}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0" />

                                <!-- Infoline: version + author + date -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Metadata.Version, StringFormat='v{0}'}"
                                               Classes="caption" />
                                    <TextBlock Text="·" Classes="caption" />
                                    <TextBlock Text="{Binding Metadata.Author}" Classes="caption" />
                                    <TextBlock Text="·" Classes="caption" />
                                    <TextBlock Text="{Binding Metadata.Created, StringFormat='{}{0:yyyy-MM-dd}'}"
                                               Classes="caption" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Metadata.Description}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />

                                <ui:InfoBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                            Margin="0,12,0,0"
                                            IsOpen="{Binding Validation.IsPassed}"
                                            Severity="Success"
                                            IsClosable="False"
                                            Message="{Binding Validation.Summary}" />

                                <ui:InfoBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                            Margin="0,12,0,0"
                                            IsOpen="{Binding Validation.IsSkipped}"
                                            Severity="Warning"
                                            IsClosable="False"
                                            Message="{Binding Validation.Summary}" />

                                <ui:InfoBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                            Margin="0,12,0,0"
                                            IsOpen="{Binding Validation.IsFailed}"
                                            Severity="Error"
                                            IsClosable="False"
                                            Message="{Binding Validation.Summary}" />
                            </Grid>
                        </Border>

                        <!-- STAT CARDS -->
                        <ItemsControl>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Items>

                                <Border Classes="stat-card" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="PARAMETERS" Classes="stat-label" />
                                        <TextBlock
                                            Text="{Binding Pipeline.Model.TotalParameters, StringFormat='{}{0:N0}'}"
                                            Classes="stat-value" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="stat-card" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="CLASSES" Classes="stat-label" />
                                        <TextBlock Text="{Binding OutputSpec.NumClasses}"
                                                   Classes="stat-value" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="stat-card" Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="SPECTRAL BANDS" Classes="stat-label" />
                                        <TextBlock Text="{Binding InputSpec.SpectralBands}"
                                                   Classes="stat-value" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="stat-card">
                                    <StackPanel>
                                        <TextBlock Text="PATCH SIZE" Classes="stat-label" />
                                        <TextBlock Text="{Binding PatchSizeDisplay}"
                                                   Classes="stat-value" />
                                    </StackPanel>
                                </Border>

                            </ItemsControl.Items>
                        </ItemsControl>

                        <!-- PIPELINE: visual flow diagram -->
                        <Border Classes="section-card">
                            <StackPanel Spacing="14">
                                <TextBlock Text="PIPELINE" Classes="section-label" />

                                <Grid ColumnDefinitions="*,Auto,*,Auto,*" VerticalAlignment="Stretch">

                                    <!-- Step 1: Preprocessing -->
                                    <Border Grid.Column="0" Classes="pipeline-stage">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="PREPROCESS" Classes="stat-label" />

                                            <ItemsControl ItemsSource="{Binding Pipeline.PreprocessingStepsForDisplay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="tag" Margin="0,2,4,2">
                                                            <TextBlock Text="{Binding}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="→" Classes="arrow" />

                                    <!-- Step 2: Spectral Reducer -->
                                    <Border Grid.Column="2" Classes="pipeline-stage">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="SPECTRAL REDUCE" Classes="stat-label"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="1"
                                                        Classes="pill success"
                                                        IsVisible="{Binding Pipeline.SpectralReducer.EmbeddedInOnnx}">
                                                    <TextBlock Text="Embedded into model" />
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Classes="pill"
                                                        IsVisible="{Binding !Pipeline.SpectralReducer.EmbeddedInOnnx}">
                                                    <TextBlock Text="External (run separately)" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Pipeline.SpectralReducer.Method}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                                <Run Text="{Binding Pipeline.SpectralReducer.InputBands}" />
                                                <Run Text=" → " />
                                                <Run Text="{Binding Pipeline.SpectralReducer.OutputBands}" />
                                                <Run Text=" bands" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="3" Text="→" Classes="arrow" />

                                    <!-- Step 3: Model -->
                                    <Border Grid.Column="4" Classes="pipeline-stage">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="MODEL" Classes="stat-label" />
                                            <TextBlock Text="{Binding Pipeline.Model.Architecture}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Pipeline.Model.Task}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- TESTING METRICS -->
                        <Border Classes="section-card">
                            <StackPanel Spacing="14">
                                <TextBlock Text="TESTING METRICS" Classes="section-label" />
                                
                                <UniformGrid Columns="5">
                                    <StackPanel Margin="0,0,12,0" Spacing="4">
                                        <TextBlock Text="ACCURACY" Classes="stat-label" />
                                        <TextBlock
                                            Text="{Binding Training.TestMetrics.Accuracy, StringFormat='{}{0:P1}'}"
                                            Classes="stat-value" />
                                        <ProgressBar Value="{Binding Training.TestMetrics.Accuracy}"
                                                     Minimum="0" Maximum="1" Height="3" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0" Spacing="4">
                                        <TextBlock Text="PRECISION" Classes="stat-label" />
                                        <TextBlock
                                            Text="{Binding Training.TestMetrics.Precision, StringFormat='{}{0:P1}'}"
                                            Classes="stat-value" />
                                        <ProgressBar Value="{Binding Training.TestMetrics.Precision}"
                                                     Minimum="0" Maximum="1" Height="3" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0" Spacing="4">
                                        <TextBlock Text="RECALL" Classes="stat-label" />
                                        <TextBlock
                                            Text="{Binding Training.TestMetrics.Recall, StringFormat='{}{0:P1}'}"
                                            Classes="stat-value" />
                                        <ProgressBar Value="{Binding Training.TestMetrics.Recall}"
                                                     Minimum="0" Maximum="1" Height="3" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0" Spacing="4">
                                        <TextBlock Text="F1 SCORE" Classes="stat-label" />
                                        <TextBlock Text="{Binding Training.TestMetrics.F1, StringFormat='{}{0:P1}'}"
                                                   Classes="stat-value" />
                                        <ProgressBar Value="{Binding Training.TestMetrics.F1}"
                                                     Minimum="0" Maximum="1" Height="3" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="AUC-ROC" Classes="stat-label" />
                                        <TextBlock
                                            Text="{Binding Training.TestMetrics.AucRoc, StringFormat='{}{0:P1}'}"
                                            Classes="stat-value" />
                                        <ProgressBar Value="{Binding Training.TestMetrics.AucRoc}"
                                                     Minimum="0" Maximum="1" Height="3" Margin="0,2,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                                
                            </StackPanel>
                        </Border>

                        <!-- I/O SPEC (side-by-side) -->
                        <Grid ColumnDefinitions="*,12,*">

                            <Border Grid.Column="0" Classes="section-card">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="INPUT SPEC" Classes="section-label" />
                                    <shared:LabeledRow Label="Tensor Layout" Value="{Binding InputSpec.TensorLayout}" />
                                    <shared:LabeledRow Label="Input Rank" Value="{Binding InputSpec.InputRank}" />
                                    <shared:LabeledRow Label="Spectral Bands" Value="{Binding InputSpec.SpectralBands}" />
                                    <shared:LabeledRow Label="Patch Size" Value="{Binding PatchSizeDisplay}" />
                                    <shared:LabeledRow Label="Data Type" Value="{Binding InputSpec.Dtype}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Classes="section-card">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="OUTPUT SPEC" Classes="section-label" />
                                    <shared:LabeledRow Label="Type" Value="{Binding OutputSpec.Type}" />
                                    <shared:LabeledRow Label="Num Classes" Value="{Binding OutputSpec.NumClasses}" />

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Classes" Classes="label" />
                                        <ItemsControl ItemsSource="{Binding OutputSpec.Classes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="tag" Margin="0,2,4,2">
                                                        <TextBlock Text="{Binding}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ARCHITECTURE -->
                        <Border Classes="section-card">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="ARCHITECTURE" Classes="section-label" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Pipeline.Model.TrainableParameters, StringFormat='{}{0:N0} trainable'}"
                                               Classes="caption" />
                                </Grid>

                                <!-- Layer tags -->
                                <ItemsControl ItemsSource="{Binding Pipeline.Model.Layers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="tag" Margin="0,2,6,2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Key}" />
                                                    <TextBlock Text="{Binding Value, StringFormat='×{0}'}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Architecture diagram (not really used) -->
                                <Image Source="{Binding ArchitectureDiagramPath}"
                                       MaxHeight="320"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       Margin="0,4,0,0"
                                       IsVisible="{Binding Artifacts.ArchitectureDiagram,
                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </shared:SidebarLayout.MainContent>
    </shared:SidebarLayout>

</UserControl>