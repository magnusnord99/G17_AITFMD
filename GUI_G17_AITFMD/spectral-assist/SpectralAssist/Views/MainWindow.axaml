<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpectralAssist.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="SpectralAssist.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SpectralAssist">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <!-- Main Layout -->
        <Grid RowDefinitions="Auto,*">

            <!-- Top Bar -->
            <Border Grid.Row="0"
                    Background="#1A1A1A"
                    BorderBrush="#2D2D2D"
                    BorderThickness="0,0,1,0"
                    Padding="10">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Left Section -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Spacing="4">
                        
                        <!-- App Logo -->
                        <TextBlock Text="SpectralAssist"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="#CCCCCC"
                                   Margin="4,0,4,0" />

                        <Border Width="1" Background="#2D2D2D" Margin="0,0,0,4" />

                        <!-- Navigational -->
                        <Button Content="Home"
                                Command="{Binding NavigateToHomeCommand}"
                                Background="Transparent"
                                Foreground="#AAAAAA"
                                Padding="8,6"
                                CornerRadius="4" />

                        <Button Content="Library"
                                Command="{Binding NavigateToLibraryCommand}"
                                Background="Transparent"
                                Foreground="#AAAAAA"
                                Padding="8,6"
                                CornerRadius="4" />

                        <Button Content="Models"
                                Command="{Binding NavigateToModelsCommand}"
                                Background="Transparent"
                                Foreground="#AAAAAA"
                                Padding="8,6"
                                CornerRadius="4" />

                        <Border Width="1" Background="#2D2D2D" Margin="0,8,0,4" />

                        <Button Content="Open HSI"
                                Click="OpenHSIButton_Clicked"
                                Background="Transparent"
                                Foreground="#AAAAAA"
                                Padding="8,6"
                                CornerRadius="4" />
                    </StackPanel>

                    <!-- Middle Spacer-->
                    <TextBlock Grid.Column="1" />

                    <!-- Right Section-->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        
                        <TextBlock Text="Active model:"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="8,8,8,2"/>
                        
                        <TextBlock Text="{Binding ActiveModel.DisplayName, FallbackValue='No model selected'}"
                                   FontSize="11"
                                   Foreground="#888"
                                   Margin="8,8,8,2" />

                        <!-- Stride Dropdown -->
                        <TextBlock Text="Stride:"
                                   FontSize="11"
                                   Foreground="#888888"
                                   Margin="8,8,8,2"
                                   ToolTip.Tip="Patch overlap for inference (higher overlap is smoother but slower)" />

                        <ComboBox ItemsSource="{Binding AvailableStrides}"
                                  SelectedItem="{Binding SelectedStride}"
                                  HorizontalAlignment="Stretch"
                                  FontSize="11"
                                  Margin="8,0"
                                  ToolTip.Tip="Controls smoothness vs. speed of inference overlay" />
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Bottom: Dynamic Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>


        <!-- Drag and Drop Overlay -->
        <Border IsVisible="{Binding IsDragging}"
                IsHitTestVisible="False"
                Background="#CC000000"
                CornerRadius="8"
                Margin="16">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="{Binding DragIcon}"
                           FontSize="48"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DragMessage}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
            </StackPanel>

        </Border>

    </Grid>

</Window>