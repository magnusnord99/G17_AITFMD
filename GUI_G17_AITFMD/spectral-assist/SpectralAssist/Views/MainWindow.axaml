<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpectralAssist.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="SpectralAssist.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        MinWidth="1500"
        MinHeight="800"
        Icon="/Assets/spectralassist-logo.ico"
        Title="SpectralAssist"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <!-- Main Layout -->
        <Grid RowDefinitions="Auto,*">

            <!-- Top Bar -->
            <Border Grid.Row="0" Classes="topbar" Padding="10">

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- Left Section -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                HorizontalAlignment="Left" Spacing="4">

                        <TextBlock Text="SpectralAssist"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="4,0,4,0" />

                        <Border Width="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,4" />

                        <Button Content="Open HSI" Classes="nav"
                                Click="OpenHSIButton_Clicked" />

                        <Button Content="Library" Classes="nav"
                                Classes.active="{Binding IsOnLibrary}"
                                Command="{Binding NavigateToLibraryCommand}" />
                        
                        <Button Content="Models" Classes="nav"
                                Classes.active="{Binding IsOnModels}"
                                Command="{Binding NavigateToModelsCommand}" />

                        <Border Width="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,8,0,4" />
                        
                        <Grid ColumnDefinitions="Auto,Auto"
                              IsVisible="{Binding HasOpenImage}"
                              VerticalAlignment="Center">
                            <Button Grid.Column="0"
                                    Content="{Binding OpenImageDisplayName}"
                                    Classes="nav"
                                    Classes.active="{Binding IsOnImageView}"
                                    Command="{Binding NavigateToOpenImageCommand}"
                                    Padding="8,6,4,6" />
                            <Button Grid.Column="1"
                                    Classes="icon"
                                    Command="{Binding CloseOpenImageCommand}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Close image">
                                <ui:SymbolIcon Symbol="Cancel" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Button>
                        </Grid>
                        
                    </StackPanel>

                    <!-- Center spacer -->
                    <Grid Grid.Column="1" />

                    <!-- Right Section -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                Spacing="12" VerticalAlignment="Center">

                        <TextBlock Text="Model:"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="Active model used for inference" />

                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                  SelectedItem="{Binding Session.ActiveModel}"
                                  MinWidth="180" FontSize="11"
                                  PlaceholderText="No model selected"
                                  ToolTip.Tip="Active model used for inference">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Stride:"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="Patch overlap for inference (higher overlap is smoother but slower)" />

                        <ComboBox ItemsSource="{Binding Session.AvailableStrides}"
                                  SelectedItem="{Binding Session.SelectedStride}"
                                  MinWidth="110" FontSize="11"
                                  ToolTip.Tip="Controls smoothness vs. speed of inference overlay" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom: Dynamic Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
        </Grid>


        <!-- Drag and Drop Overlay -->
        <Border IsVisible="{Binding IsDragging}"
                IsHitTestVisible="False"
                Background="#CC000000"
                CornerRadius="8"
                Margin="16">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="{Binding DragIcon}"
                           FontSize="48"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DragMessage}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center" />
            </StackPanel>

        </Border>

    </Grid>

</Window>