<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SpectralAssist.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="SpectralAssist.Views.ExportDialog"
        x:DataType="vm:ExportDialogViewModel"
        Title="PDF Export Options"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <Border Margin="12"
            Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            BoxShadow="0 8 28 0 #99000000">

        <StackPanel Spacing="16" Margin="24,20">

            <!-- Header row: title + close button -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="PDF Export Options"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="icon"
                        Command="{Binding CancelCommand}"
                        ToolTip.Tip="Close">
                    <ui:SymbolIcon Symbol="Cancel" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Button>
            </Grid>

            <!-- Info -->
            <StackPanel Spacing="6">
                <TextBlock Text="The exported PDF will include four images:"
                           Classes="caption" />
                <StackPanel Margin="0,4,0,0" Spacing="2">
                    <TextBlock Text="• Original RGB image"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                    <TextBlock Text="• Full overlay (0% threshold)"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                    <TextBlock Text="• Overlay using threshold 1"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                    <TextBlock Text="• Overlay using threshold 2"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                </StackPanel>
            </StackPanel>

            <Border Classes="divider" />

            <!-- Colormap -->
            <StackPanel Spacing="6">
                <TextBlock Text="Overlay colormap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="11" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding AvailableColorMaps}"
                          SelectedItem="{Binding SelectedColorMapName}"
                          HorizontalAlignment="Stretch"
                          FontSize="12" />
            </StackPanel>

            <!-- Opacity -->
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Overlay opacity"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Opacity, StringFormat='{}{0:P0}'}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="11" Width="36" TextAlignment="Right" />
                </Grid>
                <Slider Value="{Binding Opacity}" Minimum="0" Maximum="1" />
            </StackPanel>

            <!-- Threshold 1 -->
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Overlay threshold 1"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Overlay1Threshold, StringFormat='{}{0:P0}'}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="11" Width="36" TextAlignment="Right" />
                </Grid>
                <Slider Value="{Binding Overlay1Threshold}" Minimum="0" Maximum="1" />
            </StackPanel>

            <!-- Threshold 2 -->
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Overlay threshold 2"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Overlay2Threshold, StringFormat='{}{0:P0}'}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               FontSize="11" Width="36" TextAlignment="Right" />
                </Grid>
                <Slider Value="{Binding Overlay2Threshold}" Minimum="0" Maximum="1" />
            </StackPanel>

            <Border Classes="divider" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel"
                        Classes="action"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        MinWidth="90" />
                <Button Content="Export"
                        Classes="primary"
                        Padding="12,6"
                        Command="{Binding ConfirmCommand}"
                        IsDefault="True"
                        MinWidth="90" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
