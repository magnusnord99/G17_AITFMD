<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">

            <!-- Surfaces (slateDark 1–5: app → sidebar → panel → card → elevated) -->
            <Color x:Key="SolidBackgroundFillColorBase">#000000</Color>
            <Color x:Key="SolidBackgroundFillColorSecondary">#000000</Color>
            <Color x:Key="SolidBackgroundFillColorTertiary">#000000</Color>
            <Color x:Key="SolidBackgroundFillColorQuarternary">#000000</Color>

            <Color x:Key="CardBackgroundFillColorDefault">#000000</Color>
            <Color x:Key="CardBackgroundFillColorSecondary">#000000</Color>

            <Color x:Key="LayerFillColorDefault">#000000</Color>
            <Color x:Key="LayerFillColorAlt">#000000</Color>

            <!-- Borders (slateDark 6–8) -->
            <Color x:Key="CardStrokeColorDefault">#000000</Color>
            <Color x:Key="ControlStrokeColorDefault">#000000</Color>
            <Color x:Key="ControlStrokeColorSecondary">#000000</Color>
            <Color x:Key="DividerStrokeColorDefault">#000000</Color>
            <Color x:Key="SurfaceStrokeColorDefault">#000000</Color>

            <!-- Text (slateDark 9–12, ascending contrast) -->
            <Color x:Key="TextFillColorPrimary">#000000</Color>
            <Color x:Key="TextFillColorSecondary">#000000</Color>
            <Color x:Key="TextFillColorTertiary">#000000</Color>
            <Color x:Key="TextFillColorDisabled">#000000</Color>
            <Color x:Key="TextOnAccentFillColorPrimary">#000000</Color>
            <Color x:Key="TextOnAccentFillColorSecondary">#000000</Color>
            <Color x:Key="TextOnAccentFillColorDisabled">#000000</Color>

            <!-- Accent (blueDark 7–10) -->
            <Color x:Key="SystemAccentColor">#0090FF</Color>
            <Color x:Key="SystemAccentColorLight1">#3B9EFF</Color> 
            <Color x:Key="SystemAccentColorLight2">#52A9FF</Color>
            <Color x:Key="SystemAccentColorLight3">#7CC4FF</Color>
            <Color x:Key="SystemAccentColorDark1">#0079D9</Color>
            <Color x:Key="SystemAccentColorDark2">#0058B0</Color>
            <Color x:Key="SystemAccentColorDark3">#003E92</Color>

            <Color x:Key="AccentFillColorDefault">#0090FF</Color>
            <Color x:Key="AccentFillColorSecondary">#0079D9</Color>
            <Color x:Key="AccentFillColorTertiary">#0058B0</Color>

            <!-- Semantic (greenDark / amberDark / redDark 9 + 2 for backgrounds) -->
            <Color x:Key="SystemFillColorSuccess">#30A46C</Color>
            <Color x:Key="SystemFillColorSuccessBackground">#0D1F17</Color>
            <Color x:Key="SystemFillColorCaution">#FFB224</Color>
            <Color x:Key="SystemFillColorCautionBackground">#271700</Color>
            <Color x:Key="SystemFillColorCritical">#E5484D</Color>
            <Color x:Key="SystemFillColorCriticalBackground">#291415</Color>
            <Color x:Key="SystemFillColorNeutral">#9BA1A6</Color>
            <Color x:Key="SystemFillColorNeutralBackground">#1D1F22</Color>
            <Color x:Key="SystemFillColorAttention">#0090FF</Color>
            <Color x:Key="SystemFillColorAttentionBackground">#0D1A2B</Color>

        </ResourceDictionary>
        
        <ResourceDictionary x:Key="Light">

            <!-- Surfaces (slate 1–5) -->
            <Color x:Key="SolidBackgroundFillColorBase">#FBFCFD</Color>
            <Color x:Key="SolidBackgroundFillColorSecondary">#F1F3F5</Color>
            <Color x:Key="SolidBackgroundFillColorTertiary">#ECEEF0</Color>
            <Color x:Key="SolidBackgroundFillColorQuarternary">#E6E8EB</Color>

            <Color x:Key="CardBackgroundFillColorDefault">#FFFFFF</Color>
            <Color x:Key="CardBackgroundFillColorSecondary">#F8F9FA</Color>

            <Color x:Key="LayerFillColorDefault">#F8F9FA</Color>
            <Color x:Key="LayerFillColorAlt">#FFFFFF</Color>

            <!-- Borders (slate 6–8) -->
            <Color x:Key="CardStrokeColorDefault">#DFE3E6</Color>
            <Color x:Key="ControlStrokeColorDefault">#D7DBDF</Color>
            <Color x:Key="ControlStrokeColorSecondary">#C1C8CD</Color>
            <Color x:Key="DividerStrokeColorDefault">#DFE3E6</Color>
            <Color x:Key="SurfaceStrokeColorDefault">#D7DBDF</Color>

            <!-- Text (slate 8–12, ascending contrast) -->
            <Color x:Key="TextFillColorPrimary">#1A1D1E</Color>
            <Color x:Key="TextFillColorSecondary">#687076</Color>
            <Color x:Key="TextFillColorTertiary">#889096</Color>
            <Color x:Key="TextFillColorDisabled">#C1C8CD</Color>
            <Color x:Key="TextOnAccentFillColorPrimary">#FFFFFF</Color>
            <Color x:Key="TextOnAccentFillColorSecondary">#E5F0FF</Color>
            <Color x:Key="TextOnAccentFillColorDisabled">#A0BFE0</Color>

            <!-- Accent (blue 7–10) -->
            <Color x:Key="SystemAccentColor">#0090FF</Color>
            <Color x:Key="SystemAccentColorLight1">#369EFF</Color>
            <Color x:Key="SystemAccentColorLight2">#5EB1FF</Color>
            <Color x:Key="SystemAccentColorLight3">#8DCBFF</Color>
            <Color x:Key="SystemAccentColorDark1">#0079D9</Color>
            <Color x:Key="SystemAccentColorDark2">#0064B7</Color>
            <Color x:Key="SystemAccentColorDark3">#004B8C</Color>

            <Color x:Key="AccentFillColorDefault">#0090FF</Color>
            <Color x:Key="AccentFillColorSecondary">#0079D9</Color>
            <Color x:Key="AccentFillColorTertiary">#0064B7</Color>

            <!-- Semantic (green / amber / red 9 + 2 for backgrounds) -->
            <Color x:Key="SystemFillColorSuccess">#30A46C</Color>
            <Color x:Key="SystemFillColorSuccessBackground">#E9F9EE</Color>
            <Color x:Key="SystemFillColorCaution">#9D5D00</Color>
            <Color x:Key="SystemFillColorCautionBackground">#FFF7D6</Color>
            <Color x:Key="SystemFillColorCritical">#CE2C31</Color>
            <Color x:Key="SystemFillColorCriticalBackground">#FFEFEF</Color>
            <Color x:Key="SystemFillColorNeutral">#60646C</Color>
            <Color x:Key="SystemFillColorNeutralBackground">#EEEFF1</Color>
            <Color x:Key="SystemFillColorAttention">#0090FF</Color>
            <Color x:Key="SystemFillColorAttentionBackground">#E0F2FE</Color>

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
