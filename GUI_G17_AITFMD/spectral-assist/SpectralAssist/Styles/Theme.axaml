<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Translucent overlays used over images -->
    <SolidColorBrush x:Key="OverlayBackground" Color="#CC1E1E1E" />
    <SolidColorBrush x:Key="OverlayBackgroundStrong" Color="#DD1A1A1A" />

    <!-- Accent  -->
    <SolidColorBrush x:Key="AccentSubtle" Color="{DynamicResource SystemAccentColorDark2}" />

    <!-- Layout tokens -->
    <x:Double x:Key="SidebarWidth">260</x:Double>
    <x:Double x:Key="LabelColumnWidth">160</x:Double>

    <!-- Type scale tokens -->
    <x:Double x:Key="FontSizeMicro">11</x:Double>
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeLarge">14</x:Double>
    <x:Double x:Key="FontSizeXLarge">18</x:Double>
    <x:Double x:Key="FontSizeHero">22</x:Double>
    
    <!-- Corner Radius -->
    <CornerRadius x:Key="ControlCornerRadiusSmall">3</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>

</ResourceDictionary>
