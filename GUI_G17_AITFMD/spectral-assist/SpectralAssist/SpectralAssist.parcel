{
    "GeneralSettings": {
        "NetProjectPath": "SpectralAssist.csproj",
        "ApplicationName": "SpectralAssist",
        "Version": "1.0.0",
        "PackageName": {
            "$type": "msbuild",
            "property": "SpectralAssist"
        },
        "AssemblyName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        }
    },
    "LinuxSettings": {
        "InstallDirName": "spectral-assist",
        "AppIcon": "Assets/icon-724x724px.png",
        "Maintainer": "",
        "CreateBinSymlink": "True"
    },
    "Win32Settings": {
        "InstallerIcon": "Assets/icon-256x256px.ico",
        "Company": "G17",
        "IncludeUninstaller": "True"
    },
    "MacOsSettings": {
        "CreateBundle": true,
        "BundleIdentifier": "com.G17.SpectralAssist",
        "TeamId": "",
        "BundleCategory": "Utilities",
        "AppIcon": "Assets/icon-1024x1024px.icns",
        "SigningCredentialsType": "AdHoc"
    },
    "PublishSettings": {
        "PublishSingleFile": "True",
        "ExtraBuildProperties": {}
    }
}